# Used by docker compose and scripts/setup-integration.sh. Copy to .env, or run
# `npm run setup:integration`, which also generates the empty secrets below.

# n8n encrypts its credential store with this. Changing it orphans saved credentials.
N8N_ENCRYPTION_KEY=

# Separate HMAC keys per direction, so one leak can't forge the other direction.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Where Convex sends events, as reached from wherever Convex runs. The default
# suits a local Convex deployment. A cloud deployment needs a public URL (a tunnel).
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request-event

# Where n8n reaches Convex HTTP actions, as seen from inside the n8n container.
# Local Convex serves these on port 3211. For cloud use https://<name>.convex.site.
CONVEX_SITE_URL=http://host.docker.internal:3211

# Receives alerts from the error workflow.
OPS_EMAIL=ops@lendloop.local

# Mailpit by default, viewable at http://localhost:8025. Point at a real provider
# to send real mail.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
